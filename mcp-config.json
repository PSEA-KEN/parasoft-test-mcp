{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/specification/main/schema/mcp_config_schema.json",
  "mcpServers": {
    "parasoft-test": {
      "command": "node",
      "args": ["./mcp-server/index.js"],
      "cwd": ".",
      "env": {
        "NODE_ENV": "development",
        "DEBUG": "mcp:*"
      }
    }
  },
  "logging": {
    "level": "info",
    "file": "mcp.log"
  },
  "client": {
    "name": "parasoft-test-client",
    "version": "1.0.0",
    "capabilities": {
      "experimental": {},
      "sampling": {}
    }
  }
}